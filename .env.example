# ---------------------------------------------------------------- phase 1 ---
# Neon pooled connection string.
DATABASE_URL=
# Signs the admin session cookie. 32+ characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Seed credentials for the single admin account. Changeable later in /admin/profil.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- phase 2 ---
# ImageKit. The private key never reaches the browser.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# ---------------------------------------------------------------- phase 4 ---
# Resend. The recipient address and the Telegram chat id live in /admin/profil,
# not here.
RESEND_API_KEY=
RESEND_FROM=
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------- phase 7 ---
# OpenAI, pour le bouton « Remplir depuis la photo » de la fiche produit. Sans
# cette clé le bouton n'apparaît pas : rien d'autre ne change. Le modèle doit
# savoir lire une image.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ------------------------------------------------------------------ tests ---
# Sans ces deux variables, `npm run test:e2e` passe la moitié admin du parcours
# et le rapport affiche « skipped » sans que rien n'ait échoué. Jamais en
# production.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# ---------------------------------------------------------------- phase 6 ---
# Meta. L'identifiant du pixel est public — il part dans le HTML — mais il n'est
# jamais codé en dur : le serveur et le navigateur lisent cette seule variable,
# donc changer de dataset est un changement de valeur, pas de code.
# Dataset actuel : « DakarKits' market ».
NEXT_PUBLIC_META_PIXEL_ID=1586569049354254
# Le jeton est propre au dataset. Changer de pixel sans régénérer le jeton fait
# échouer l'API de conversions en silence (voir les logs `[meta]`).
META_CAPI_ACCESS_TOKEN=
# Temporary, for Events Manager test events only. Remove before going live.
META_CAPI_TEST_EVENT_CODE=
